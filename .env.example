# CustomerChatbot configuration
#
# Copy to .env and fill in what you need.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Reasoning engine
#
# A model is REQUIRED. There is no keyword fallback: with nothing set here,
# every turn answers "I can't reach our systems right now" and stops. That is
# deliberate -- a support bot quietly answering from a keyword table is wrong
# without telling you -- but it does mean one of these two is not optional.
#
#   1. ANTHROPIC_API_KEY    -> Claude
#   2. CHATBOT_BASE_URL     -> your own model server (vLLM, SGLang, Ollama,
#                              llama.cpp, LM Studio, Docker Model Runner)
# ---------------------------------------------------------------------------

# --- Option 1: hosted Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# CHATBOT_MODEL=claude-sonnet-4-5

# --- Option 2: self-hosted open-weights model ---
# Setting a base URL is enough; the provider is inferred from it.
# CHATBOT_BASE_URL=http://localhost:8000/v1
# CHATBOT_MODEL=Qwen/Qwen3-8B
# Local servers ignore the key but the SDK requires a non-empty value.
# CHATBOT_API_KEY=local-no-key-required

# Force a provider instead of inferring: auto | anthropic | openai
# CHATBOT_PROVIDER=auto

# Which engine to run:
#   auto  (default) LLM when a backend resolves, rules otherwise
#   llm             prefer the LLM -- still falls back to rules on failure
#   rules           never call a model, even if one is configured
# CHATBOT_ENGINE=auto

# Maximum tool-call rounds per customer message.
# CHATBOT_MAX_STEPS=6

# Force the policy agent's first call to be a tool call.
#
# The prompt already tells it to search the knowledge base before answering.
# Measured over a 40-turn run, it did so on its own 8 times out of 33; the
# grounding guard fetched the passages the other 25 times, after the model had
# already answered from memory. This sends tool_choice="required" on the
# opening policy call, so the search happens first by construction. Later
# steps stay "auto" -- the agent still has to be free to stop and write the
# answer.
#
# Off by default so it can be A/B'd:
#   python simulate_customer.py --url http://localhost:8001 --scorecard
# with and without it. Servers that reject tool_choice fall back to "auto"
# automatically, with a warning in the log.
# CHATBOT_FORCE_POLICY_SEARCH=1

# Reply length cap. Small local models benefit from a lower value.
# CHATBOT_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Policy retrieval
# ---------------------------------------------------------------------------

# Dense embeddings are used automatically when model2vec or
# sentence-transformers is installed. Set this to force them off.
# CHATBOT_DISABLE_EMBEDDINGS=1

# Override the embedding model.
#   model2vec default:             minishlab/potion-base-8M
#   sentence-transformers default: all-MiniLM-L6-v2
# CHATBOT_EMBEDDING_MODEL=minishlab/potion-base-8M

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# ENVIRONMENT=development
# LOG_LEVEL=INFO
